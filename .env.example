# ------------------------------------------------------------------
# Azure StellarPay Hub - environment template
# Copy to `.env` (root) or run `pnpm generate:env` to scaffold per-app envs.
# ------------------------------------------------------------------

# --- Node ---------------------------------------------------------
NODE_ENV=development

# --- API ----------------------------------------------------------
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003

# --- Auth / JWT ---------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d
SESSION_TTL_SECONDS=604800

# --- Postgres (Prisma) --------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/stellar_pay?schema=public

# --- Redis --------------------------------------------------------
REDIS_URL=redis://localhost:6379

# --- Stellar ------------------------------------------------------
# public | testnet | standalone
STELLAR_NETWORK=testnet
HORIZON_URL=https://horizon-testnet.stellar.org
# Soroban RPC endpoint for smart contract interactions
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
# --- Soroban payment route (experimental, off by default) ---------------------
# PAYMENT_ROUTE=classic            # classic = Stellar Operation.payment; contract = Soroban `send`
# CONTRACT_STELLAR_PAY_PAYMENT=    # deployed payment contract address (see .deployed-contracts.env)
# PAYMENT_CONTRACT_ASSETS=XLM      # assets routed through the contract (SAC must be allowlisted on-chain)
# Freighter/Albedo/xBull use these well-known passphrases; keep in sync.
NETWORK_PASSPHRASE=

# --- Admin (seeded account) ----------------------------------------
ADMIN_EMAIL=admin@stellar-pay.dev
ADMIN_PASSWORD=ChangeMe123!

# --- Notifications -------------------------------------------------
NOTIFICATIONS_EMAIL_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMS_PROVIDER=console
SMS_API_KEY=
PUSH_PROVIDER=console
WEBHOOK_SIGNING_SECRET=change-me-webhook-secret

# --- IPFS ----------------------------------------------------------
IPFS_PROVIDER=local                  # local | pinata | web3
IPFS_GATEWAY=https://ipfs.io/ipfs/
IPFS_API_URL=http://localhost:5001   # required for local provider
IPFS_API_KEY=
PINATA_JWT=                          # required for pinata provider
WEB3_STORAGE_TOKEN=                  # required for web3 provider

# --- Analytics -----------------------------------------------------
ANALYTICS_PROVIDER=console

# --- Apps (public URLs, used for links in emails/notifications) ----
WEB_APP_URL=http://localhost:3000
ADMIN_APP_URL=http://localhost:3001
EXPLORER_APP_URL=http://localhost:3002
DOCS_APP_URL=http://localhost:3003

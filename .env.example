# Azure StellarPay Hub — Environment Variables
# Copy this file to .env and fill in your values.

# ── API ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
METRICS_ENABLED=false
CORS_ORIGINS=http://localhost:3000

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_TO_A_STRONG_SECRET_AT_LEAST_16_CHARS
JWT_EXPIRES_IN=7d
SESSION_TTL_SECONDS=604800

# ── Database / Cache ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/stellar_pay?schema=public
REDIS_URL=redis://localhost:6379

# ── Stellar ──────────────────────────────────────────────────────────────────
STELLAR_NETWORK=testnet
HORIZON_URL=https://horizon-testnet.stellar.org
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# ── Soroban Payment Route (experimental) ─────────────────────────────────────
PAYMENT_ROUTE=classic
CONTRACT_STELLAR_PAY_PAYMENT=
CONTRACT_STELLAR_PAY_ESCROW=
CONTRACT_STELLAR_PAY_INVOICES=
CONTRACT_STELLAR_PAY_SUBSCRIPTIONS=
CONTRACT_STELLAR_PAY_TREASURY=
CONTRACT_STELLAR_PAY_MERCHANT=
PAYMENT_CONTRACT_ASSETS=XLM

# ── Admin ────────────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@stellar-pay.dev
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# ── Notifications ────────────────────────────────────────────────────────────
NOTIFICATIONS_EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMS_PROVIDER=console
SMS_API_KEY=
PUSH_PROVIDER=console
WEBHOOK_SIGNING_SECRET=CHANGE_ME_WEBHOOK_SECRET_AT_LEAST_16_CHARS

# ── IPFS ─────────────────────────────────────────────────────────────────────
IPFS_PROVIDER=local
IPFS_GATEWAY=https://ipfs.io/ipfs/
IPFS_API_URL=
IPFS_API_KEY=
PINATA_JWT=
WEB3_STORAGE_TOKEN=

# ── Analytics ────────────────────────────────────────────────────────────────
ANALYTICS_PROVIDER=console

# ── App URLs ─────────────────────────────────────────────────────────────────
WEB_APP_URL=http://localhost:3000
ADMIN_APP_URL=http://localhost:3001
EXPLORER_APP_URL=http://localhost:3002
DOCS_APP_URL=http://localhost:3003

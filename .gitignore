# Dependencies
node_modules/
.pnpm-store/

# Builds
dist/
build/
.next/
out/
.turbo/
.nx/
coverage/
*.tsbuildinfo

# Rust / Soroban
contracts/target/
contracts/**/target/
contracts/**/test_snapshots/
*.wasm

# npm (project uses pnpm)
package-lock.json

# Generated at build time, never hand-edited
# - the Prisma client is produced by `pnpm db:generate` (the database package's
#   build/typecheck scripts run it, and CI runs it explicitly before linting)
#   and ships platform-specific query-engine binaries that must not be committed
# - Next.js rewrites next-env.d.ts on every `next dev` / `next build` (its own
#   header says not to edit it), so committing it dirties the worktree on every
#   build; a clean-clone typecheck was verified to pass without them
packages/database/src/generated/
apps/*/next-env.d.ts

# Environment
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editors / OS
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/

# Misc
.cache/
tmp/
.vercel
.env*
.deployed-contracts.env

# Extension compiled output (esbuild)
apps/extension/popup.js
apps/extension/background.js
apps/extension/options.js

# Video pipeline scratch space: synthesised narration, rendered scene stills,
# encoded segments, the ffmpeg/Playwright toolchain and the fonts. Everything
# here is regenerated by the scripts in video/, so only the finished artifacts
# (the mp4, the caption track, the preview and the UI screenshots) are tracked.
video/.work/
# A symlink into video/.work, so `import 'playwright'` resolves from video/*.mjs.
# The `node_modules/` rule above does not match it: a trailing slash only matches
# real directories, and this is a symlink.
video/node_modules

# API environment (see root .env.example for the full list)
NODE_ENV=development
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/stellar_pay?schema=public
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d
STELLAR_NETWORK=testnet
HORIZON_URL=https://horizon-testnet.stellar.org
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
# --- Soroban payment route (experimental, off by default) ---------------------
# PAYMENT_ROUTE=classic            # classic = Stellar Operation.payment; contract = Soroban `send`
# CONTRACT_STELLAR_PAY_PAYMENT=    # deployed payment contract address (see .deployed-contracts.env)
# PAYMENT_CONTRACT_ASSETS=XLM      # assets routed through the contract (SAC must be allowlisted on-chain)
ADMIN_EMAIL=admin@stellar-pay.dev
ADMIN_PASSWORD=ChangeMe123!
WEB_APP_URL=http://localhost:3000
WEBHOOK_SIGNING_SECRET=change-me-webhook-secret

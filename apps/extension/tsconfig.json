{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "isolatedModules": true,
    "types": ["chrome"]
  },
  "include": ["*.ts", "lib/**/*.ts"],
  "exclude": ["node_modules"]
}

{
  "name": "stellar-pay",
  "version": "0.1.0",
  "private": true,
  "description": "Azure StellarPay Hub - production-ready Stellar payment platform (monorepo)",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "nx run-many -t build",
    "build:apps": "nx run-many -t build --projects='apps/*'",
    "build:packages": "nx run-many -t build --projects='packages/*'",
    "dev": "nx run-many -t dev --parallel=3",
    "dev:web": "nx run web:dev",
    "dev:admin": "nx run admin:dev",
    "dev:api": "nx run api:dev",
    "dev:explorer": "nx run explorer:dev",
    "dev:docs": "nx run docs:dev",
    "start:api": "nx run api:start",
    "lint": "nx run-many -t lint",
    "typecheck": "nx run-many -t typecheck",
    "test": "pnpm test:unit && pnpm contracts:verify",
    "test:unit": "nx run-many -t test",
    "test:e2e": "node tests/smoke.mjs",
    "test:e2e:flow": "node tests/e2e/auth-payment-flow.mjs",
    "test:e2e:contracts": "node tests/e2e/contracts-flow.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @stellar-pay/database build",
    "db:migrate": "pnpm --filter @stellar-pay/database db:migrate",
    "db:push": "pnpm --filter @stellar-pay/database db:push",
    "db:seed": "pnpm --filter @stellar-pay/database db:seed",
    "db:studio": "pnpm --filter @stellar-pay/database db:studio",
    "contracts:build": "cargo build --manifest-path contracts/Cargo.toml --workspace --release --target wasm32v1-none",
    "contracts:test": "cargo test --manifest-path contracts/Cargo.toml --workspace",
    "contracts:verify": "node scripts/contracts-verify.mjs",
    "generate:env": "bash scripts/generate-env.sh",
    "setup": "bash scripts/setup.sh",
    "deploy:testnet": "bash scripts/deploy-testnet.sh",
    "deploy:contracts": "node scripts/deploy-contracts.mjs",
    "contracts:init": "node scripts/init-contracts.mjs",
    "docker:up": "docker compose -f infrastructure/docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f infrastructure/docker/docker-compose.yml down",
    "video:setup": "node video/setup.mjs",
    "video:narrate": "node video/synthesize.mjs",
    "video:render": "node video/render-scenes.mjs",
    "video:thumbnail": "node video/thumbnail.mjs",
    "video:capture": "node video/capture.mjs",
    "video": "node video/build-video.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^14.0.0",
    "nx": "^23.1.1",
    "prettier": "^3.9.6",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.23.8",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.66.0"
  }
}

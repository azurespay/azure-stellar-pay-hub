{
  "name": "@stellar-pay/notifications",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Multi-channel notification service: email, SMS, push, in-app, webhook",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "jest"
  },
  "dependencies": {
    "@stellar-pay/types": "workspace:*",
    "@stellar-pay/logger": "workspace:*"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "ts-jest": "^29.4.12",
    "typescript": "~5.9.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/*.test.ts"
    ],
    "moduleFileExtensions": [
      "ts",
      "js",
      "json"
    ]
  }
}
